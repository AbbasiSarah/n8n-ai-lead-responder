      "webhookId": "a3c1d8f2-5b7e-4c9a-9e21-lead-form0001",
      "parameters": {
        "formTitle": "Contact Sunrise Tech Academy",
        "formDescription": "Ask us anything. We reply within minutes.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Course",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Python for Beginners"
                  },
                  {
                    "option": "Data Science"
                  },
                  {
                    "option": "Machine Learning"
                  },
                  {
                    "option": "Web Development"
                  },
                  {
                    "option": "Not sure yet"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n2",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "business",
              "value": "Sunrise Tech Academy",
              "type": "string"
            },
            {
              "id": "s2",
              "name": "owner_email",
              "value": "you@example.com",
              "type": "string"
            },
            {
              "id": "s3",
              "name": "model",
              "value": "your-model-name",
              "type": "string"
            },
            {
              "id": "s4",
              "name": "facts",
              "type": "string",
              "value": "Courses: Python for Beginners (Rs 15,000, 6 weeks), Data Science (Rs 25,000, 10 weeks), Machine Learning (Rs 35,000, 12 weeks), Web Development (Rs 25,000, 10 weeks). Fees can be paid in 2 instalments. Weekday classes 6-8 pm Mon-Thu, weekend classes Sat 10 am-2 pm. Online (Zoom) or on campus in Islamabad. New batches start on the 1st of every month. No experience needed for Python or Web Development."
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "n3",
      "name": "Ask AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.model, max_tokens: 600, system: \"You are the friendly enquiry assistant for {business}. Read the customer's enquiry and reply ONLY with JSON: {\\\"category\\\": one of [\\\"Fees\\\", \\\"Admission\\\", \\\"Course info\\\", \\\"Timings\\\", \\\"Complaint\\\", \\\"Other\\\"], \\\"priority\\\": \\\"high\\\" if they want to join soon, are ready to pay, or are upset, otherwise \\\"normal\\\", \\\"reply\\\": a warm, short email reply (max 120 words) signed \\\"The {business} team\\\"}. Only use these facts: {facts}. If the answer isn't in the facts, say the team will reply personally within a day. Never invent prices or dates.\".replaceAll('{business}', $json.business).replace('{facts}', $json.facts), messages: [{ role: 'user', content: 'Name: ' + $json.Name + '\\nCourse: ' + $json.Course + '\\nMessage: ' + $json.Message }] }) }}",
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Read AI answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Turn the AI's text into clean fields. If anything goes wrong, use a safe default reply.\nconst form = $('Settings').first().json;\nconst text = ($input.first().json.content || [{}])[0].text || '';\nlet ai;\ntry {\n  ai = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1));\n} catch (e) {\n  ai = { category: 'Other', priority: 'normal',\n         reply: `Hi ${form.Name},\\n\\nThank you for contacting ${form.business}. Our team will reply to you personally within a day.\\n\\nThe ${form.business} team` };\n}\nreturn [{ json: {\n  date: new Date().toISOString().slice(0, 16).replace('T', ' '),\n  name: form.Name, email: form.Email, course: form.Course, message: form.Message,\n  category: ai.category, priority: ai.priority, reply: ai.reply,\n  owner_email: form.owner_email, business: form.business,\n} }];"
      }
    },
    {
      "id": "n5",
      "name": "Save lead to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [
        880,
        300
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL_HERE"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "date": "={{ $json.date }}",
            "name": "={{ $json.name }}",
            "email": "={{ $json.email }}",
            "course": "={{ $json.course }}",
            "message": "={{ $json.message }}",
            "category": "={{ $json.category }}",
            "priority": "={{ $json.priority }}",
            "reply": "={{ $json.reply }}"
          },
          "matchingColumns": [],
          "schema": [
            {
